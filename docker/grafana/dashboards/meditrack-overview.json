{
  "uid": "meditrack-platform-overview",
  "title": "MediTrack Platform Overview",
  "tags": ["meditrack", "prometheus", "observability"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "meditrack-prometheus"
        },
        "query": "label_values(up, job)",
        "definition": "label_values(up, job)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Service Availability",
      "datasource": {
        "type": "prometheus",
        "uid": "meditrack-prometheus"
      },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (job) (up{job=~\"$job\"})",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "meditrack-prometheus"
      },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$job\"}[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Utilization %",
      "datasource": {
        "type": "prometheus",
        "uid": "meditrack-prometheus"
      },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (job) (jvm_memory_used_bytes{job=~\"$job\",area=\"heap\"}) / clamp_min(sum by (job) (jvm_memory_max_bytes{job=~\"$job\",area=\"heap\"}), 1)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Process CPU Usage %",
      "datasource": {
        "type": "prometheus",
        "uid": "meditrack-prometheus"
      },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (job) (process_cpu_usage{job=~\"$job\"})",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Live JVM Threads",
      "datasource": {
        "type": "prometheus",
        "uid": "meditrack-prometheus"
      },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (jvm_threads_live_threads{job=~\"$job\"})",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "links": []
}
